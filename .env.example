# Trusted manual-reference profile. Copy to .env locally, then replace only values
# that differ on the target host. Never commit real endpoints, accounts, or tokens.
LEADER_PORT=/dev/ttyACM0
LEADER_ID=so101_leader_01
CAN_INTERFACE=can0
CAN_BITRATE=1000000
FRONT_CAMERA=0
WRIST_CAMERA=2
TASK_TEXT="Put the banana on the plate."
DATASET_REPO_ID=local/piper_record_test
DATASET_ROOT=$HOME/lerobot_work/data/piper_record_test
CHECKPOINT_PATH=$HOME/lerobot_work/models/act_piper_test_20000/pretrained_model
NUM_EPISODES=50
EPISODE_TIME_S=30
RESET_TIME_S=15
DATASET_FPS=15
ENCODER_THREADS=2
RGB_CRF=20
DURATION_S=20
ROLLOUT_EPISODES=1

# AutoDL reference values. Switch DATASET_ROOT to /root/piper_record_test before
# ACT or SmolVLA training on the cloud host.
ACT_DATASET_ROOT=/root/piper_record_test
ACT_DATASET_REPO_ID=local/piper_record_test
ACT_OUTPUT_DIR=/root/outputs/train/act_piper_test
ACT_TRAIN_STEPS=20000
DEVICE=cuda

SMOLVLA_BASE=/root/autodl-tmp/huggingface/smolvla_base
SMOLVLM_PATH=/root/autodl-tmp/huggingface/SmolVLM2-500M-Video-Instruct
SMOLVLA_DATASET_ROOT=/root/piper_record_test
SMOLVLA_DATASET_REPO_ID=piper_record_test
SMOLVLA_OUTPUT_DIR=/root/autodl-tmp/checkpoints/smolvla_piper_test
SMOLVLA_BATCH_SIZE=4
SMOLVLA_NUM_WORKERS=4
SMOLVLA_MAX_STEPS=20000
SMOLVLA_SAVE_FREQ=5000

SSH_HOST=example.invalid
SSH_PORT=22
SSH_USER=example_user
REMOTE_CHECKPOINT_PATH=/path/on/remote/pretrained_model
LOCAL_CHECKPOINT_PATH=/path/on/local/pretrained_model

POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=8080
POLICY_SERVER_URL=127.0.0.1:8080
LOCAL_FORWARD_PORT=8080
REMOTE_POLICY_PORT=8080
SMOLVLA_SYNC_CHECKPOINT_PATH=$HOME/lerobot_work/models/smolvla_piper_test_20000/pretrained_model
SMOLVLA_SERVER_CHECKPOINT_PATH=/root/autodl-tmp/checkpoints/smolvla_piper_test/020000/pretrained_model
ASYNC_CAMERA_1=/dev/video6
ASYNC_CAMERA_2=/dev/video5
ASYNC_CAMERA_FPS=10
ACTIONS_PER_CHUNK=50
CHUNK_THRESHOLD=0.5
AGGREGATE_FN=weighted_average

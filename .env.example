# Copy to .env locally. Never commit real endpoints, accounts, device paths, or tokens.
LEADER_PORT=/dev/ttyACM_X
CAN_INTERFACE=can0
CAN_BITRATE=1000000
FRONT_CAMERA=0
WRIST_CAMERA=2
TASK_TEXT=replace_with_your_task
DATASET_REPO_ID=local/replace_with_dataset_id
DATASET_ROOT=/path/to/local/dataset
CHECKPOINT_PATH=/path/to/pretrained_model

SSH_HOST=example.invalid
SSH_PORT=22
SSH_USER=example_user
REMOTE_CHECKPOINT_PATH=/path/on/remote/pretrained_model
LOCAL_CHECKPOINT_PATH=/path/on/local/pretrained_model

POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=8080
LOCAL_FORWARD_PORT=8080
REMOTE_POLICY_PORT=8080

